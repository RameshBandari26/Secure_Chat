# Logs
# =========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# Build output
# =========================
backend/dist/
backend/build/
frontend/dist/
frontend/build/
frontend/.vite/

# =========================
# Coverage / cache
# =========================
coverage/
.cache/
.parcel-cache/

# =========================
# IDE / editor
# =========================
.vscode/
.idea/

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

